<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/logoView"
            android:src="@drawable/logo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/app_name" />
        <LinearLayout
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView android:id="@+id/companyName" android:text="יוסי אמבולנס" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/text" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/welcome" android:textColor="@color/muted" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/radioBtn"
        android:text="מכשיר קשר"
        android:backgroundTint="@color/brand"
        android:layout_marginTop="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/themeBtn"
        android:text="עיצוב כהה / בהיר"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/logoutBtn"
        android:text="יציאה"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
